# ============================================================
# CONFIGURACIÓN DE APIS Y MODELOS DE INTELIGENCIA ARTIFICIAL
# ============================================================

# 1. Groq Cloud (Recomendado por velocidad - LLaMA 3.3 70B)
# Obtén tu clave gratuita en: https://console.groq.com/keys
GROQ_API_KEY=

# 2. NVIDIA NIM (DeepSeek-V4, Gemma 4, GLM 5)
# Obtén tu clave con créditos gratuitos en: https://build.nvidia.com
NVIDIA_API_KEY=

# ============================================================
# ALERTAS POR TELEGRAM (OPCIONAL)
# ============================================================
# Crea tu bot con @BotFather en Telegram y obtén tu Chat ID con @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# MODO DE PRIVACIDAD / HACKATHON
# ============================================================
# Si es true, fuerza el procesamiento 100% local (sin enviar datos a ninguna API externa)
# Si es false, usa Groq / NVIDIA NIM si tienen API Key configurada
SIEM_AI_LOCAL_ONLY=false

