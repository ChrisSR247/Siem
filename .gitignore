# ==============================================================================
# GITIGNORE - ANDESCORRELATOR ENGINE (ACE) SIEM
# ==============================================================================

# Entorno y variables secretas
.env
.env.local
.env.*.local

# Bytecode y caches de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Ambientes virtuales
venv/
.venv/
env/
ENV/

# Bases de datos SQLite generadas dinámicamente en runtime
*.db
*.sqlite3
!database/.gitkeep

# Cursors de ingesta en vivo
.wazuh_cursor
.suricata_cursor

# Logs del sistema
logs/
*.log

# Archivos comprimidos de respaldo
*.rar
*.zip

# Artefactos temporales de compilación LaTeX
*.aux
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
